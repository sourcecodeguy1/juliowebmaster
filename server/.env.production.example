NODE_ENV=production
PORT=3002
ALLOWED_ORIGIN=https://juliowebmaster.com
GROQ_API_KEY=
MAIL_PROVIDER=resend
# Set true ONLY after Resend marks juliowebmaster.com Verified.
MAIL_DOMAIN_VERIFIED=false
MAIL_USER=resend
# Domain-restricted sending API key from Resend; never a frontend variable.
MAIL_PASS=
# Explicit stable Traefik IP; do not trust the whole shared Docker network.
TRUSTED_PROXIES=
